{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "css-modules.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
